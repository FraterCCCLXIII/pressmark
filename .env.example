# Optional web sign-in. Localhost, Vite dev, and the desktop app skip the login
# wall. Hosted deploys still require it once this is enabled and an admin exists.

# Require login after setup or when an admin already exists.
# PRESSMARK_AUTH_ENABLED=true

# Force the login wall even on localhost / Electron (or add ?auth=1 to the URL).
# VITE_PRESSMARK_REQUIRE_AUTH=true

# Create the first admin on boot if that email is not already stored.
# PRESSMARK_ADMIN_EMAIL=admin@example.com
# PRESSMARK_ADMIN_PASSWORD=

# SMTP for password reset. Leave unset to keep mail in the admin outbox.
# PRESSMARK_SMTP_HOST=smtp.example.com
# PRESSMARK_SMTP_PORT=587
# PRESSMARK_SMTP_SECURE=false
# PRESSMARK_SMTP_USER=
# PRESSMARK_SMTP_PASS=
# PRESSMARK_SMTP_FROM=Pressmark <noreply@example.com>
