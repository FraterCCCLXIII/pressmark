{
	"name": "pressmark",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev-check": "npm run sv-check && npm run dev",
		"dev": "vite",
		"dev-local-lib": "vite --force",
		"electron": "npm run dev:all --prefix standalone-apps/electron",
		"electron:dev": "npm run dev --prefix standalone-apps/electron",
		"electron:build": "npm run dist --prefix standalone-apps/electron",
		"build": "vite build",
		"build-rel": "vite build --base=./",
		"preview": "vite preview",
		"sv-check": "svelte-check --tsconfig ./tsconfig.json",
		"gen-mdi-list": "node gen-mdi-list.mjs > src/styles/mdi_icons.ts",
		"lint": "eslint .",
		"format-all": "prettier --write \"src/**/*.{ts,svelte}\" \"!src/styles/mdi_icons.ts\""
	},
	"dependencies": {
		"@capacitor/core": "^8.4.1",
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/share": "^8.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/noto-sans": "^5.2.10",
		"@fontsource-variable/noto-serif": "^5.3.0",
		"@fontsource-variable/roboto-flex": "^5.3.0",
		"@formatjs/intl-localematcher": "^0.8.10",
		"@mmote/niimbluelib": "0.0.1-alpha.42",
		"@popperjs/core": "^2.11.8",
		"@tailwindcss/vite": "^4.3.3",
		"clsx": "^2.1.1",
		"d3-dsv": "^3.0.1",
		"dayjs": "^1.11.21",
		"fabric": "^7.4.0",
		"lucide": "^1.47.0",
		"material-icons": "^1.13.14",
		"nodemailer": "^10.0.10",
		"pdfjs-dist": "^6.2.108",
		"qrcode-generator": "2.0.4",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"toastify-js": "^1.12.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tsconfig/svelte": "^5.0.8",
		"@types/d3-dsv": "^3.0.7",
		"@types/node": "^24.13.2",
		"@types/nodemailer": "^8.0.2",
		"@types/qrcode-svg": "^1.1.5",
		"@types/toastify-js": "^1.12.4",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^16.5.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^3.5.2",
		"sass": "1.77.6",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^7.3.5"
	},
	"overrides": {
		"fabric": {
			"canvas": "npm:uninstall"
		}
	}
}
